<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>SecureMailScope Forensic Report</title>
<style>
  /* ── Page Setup ──────────────────────────────────────────── */
  @page {
    size: A4 portrait;
    margin-top: 24mm;
    margin-bottom: 24mm;
    margin-left: 20mm;
    margin-right: 20mm;
    @frame header_frame {
      -pdf-frame-content: hdr;
      left: 20mm; width: 170mm;
      top: 8mm; height: 10mm;
    }
    @frame footer_frame {
      -pdf-frame-content: ftr;
      left: 20mm; width: 170mm;
      bottom: 8mm; height: 8mm;
    }
  }

  /* ── Running Header / Footer ─────────────────────────────── */
  #hdr {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 7.5pt;
    color: #9ca3af;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 4px;
  }
  #ftr {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 7.5pt;
    color: #9ca3af;
    border-top: 1px solid #e5e7eb;
    padding-top: 4px;
    text-align: right;
  }

  /* ── Base Typography ─────────────────────────────────────── */
  body {
    font-family: Helvetica, Arial, sans-serif;
    color: #1f2937;
    font-size: 9pt;
    line-height: 1.5;
    margin: 0;
    padding: 0;
  }

  /* ── Report Title Block ──────────────────────────────────── */
  .report-title-block {
    border-bottom: 3px solid #0b1f3a;
    padding-bottom: 10px;
    margin-bottom: 18px;
    -pdf-keep-with-next: true;
  }
  .report-title {
    font-size: 20pt;
    font-weight: bold;
    color: #0b1f3a;
    margin: 0 0 4px 0;
  }
  .report-subtitle {
    font-size: 9pt;
    color: #4b5563;
    margin: 0;
  }

  /* ── Meta Info Table ─────────────────────────────────────── */
  .meta-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 22px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    -pdf-keep-with-next: true;
  }
  .meta-table td {
    padding: 7px 10px;
    font-size: 8.5pt;
    color: #334155;
    vertical-align: top;
    white-space: normal;
  }
  .meta-label {
    font-weight: bold;
    color: #0f172a;
    width: 20%;
    white-space: nowrap;
  }
  .meta-value {
    color: #334155;
    width: 30%;
    white-space: normal;
  }
  .meta-value-source {
    color: #334155;
    width: 30%;
    white-space: normal;
    word-wrap: break-word;
    -pdf-word-wrap: CJK;
  }

  /* ── Section Headings ────────────────────────────────────── */
  h2 {
    font-size: 12pt;
    font-weight: bold;
    color: #0b1f3a;
    margin-top: 24px;
    margin-bottom: 12px;
    padding-bottom: 5px;
    border-bottom: 2px solid #0b1f3a;
    page-break-after: avoid;
    -pdf-keep-with-next: true;
  }

  /* ── Risk Overview Boxes ─────────────────────────────────── */
  .overview-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    -pdf-keep-with-next: true;
  }
  .overview-table td {
    width: 25%;
    padding: 0 5px;
    vertical-align: top;
  }
  .risk-box {
    border: 1px solid #cbd5e1;
    border-top: 4px solid #cbd5e1;
    padding: 12px 8px;
    text-align: center;
    background-color: #ffffff;
  }
  .risk-box-label {
    font-size: 7.5pt;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .risk-box-value {
    font-size: 20pt;
    font-weight: bold;
    line-height: 1;
    margin: 0;
  }
  .rb-total { border-top-color: #0b1f3a; }
  .rb-total .risk-box-value { color: #0b1f3a; }
  .rb-low { border-top-color: #10b981; }
  .rb-low .risk-box-value { color: #059669; }
  .rb-medium { border-top-color: #f59e0b; }
  .rb-medium .risk-box-value { color: #d97706; }
  .rb-high { border-top-color: #ef4444; }
  .rb-high .risk-box-value { color: #dc2626; }

  /* ── Session Summary Table ───────────────────────────────── */
  table.summary-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    margin-bottom: 24px;
    font-size: 8.5pt;
  }
  table.summary-tbl th {
    background-color: #0b1f3a;
    color: #ffffff;
    padding: 7px 6px;
    text-align: left;
    font-size: 8pt;
    white-space: nowrap;
  }
  table.summary-tbl td {
    border: 1px solid #e2e8f0;
    padding: 7px 6px;
    font-size: 8.5pt;
    vertical-align: middle;
  }
  table.summary-tbl tr:nth-child(even) td {
    background-color: #f8fafc;
  }

  /* ── Risk Badges ─────────────────────────────────────────── */
  .badge {
    font-size: 7.5pt;
    font-weight: bold;
    padding: 2px 5px;
    display: inline-block;
    white-space: nowrap;
  }
  .badge-LOW      { background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
  .badge-MEDIUM   { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
  .badge-HIGH     { background-color: #ffedd5; color: #9a3412; border: 1px solid #fed7aa; }
  .badge-CRITICAL { background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

  /* ── Session Detail Cards ────────────────────────────────── */
  .session-card {
    border: 1px solid #cbd5e1;
    margin-bottom: 26px;
    background-color: #ffffff;
    page-break-inside: avoid;
  }
  .session-card-header {
    background-color: #0b1f3a;
    color: #ffffff;
    padding: 9px 16px;
    font-size: 10pt;
    font-weight: bold;
    -pdf-keep-with-next: true;
  }
  .session-card-body {
    padding: 14px 16px;
  }

  /* Two-column detail layout */
  .detail-col-left  { width: 49%; padding-right: 12px; vertical-align: top; }
  .detail-col-right { width: 49%; padding-left: 12px; vertical-align: top; border-left: 1px solid #e2e8f0; }

  .detail-section-title {
    font-size: 8pt;
    font-weight: bold;
    color: #0b1f3a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding-bottom: 4px;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 8px;
    -pdf-keep-with-next: true;
  }

  .detail-grid {
    width: 100%;
    border-collapse: collapse;
  }
  .detail-grid td {
    padding: 4px 2px;
    font-size: 8.5pt;
    vertical-align: top;
  }
  .detail-label {
    font-weight: bold;
    color: #475569;
    width: 38%;
    white-space: nowrap;
    padding-right: 6px;
  }
  .detail-value {
    color: #0f172a;
  }

  /* ── Divider ─────────────────────────────────────────────── */
  .divider {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 14px 0;
  }

  /* ── Attack Detection Box ────────────────────────────────── */
  .attack-box {
    border: 1px solid #fca5a5;
    background-color: #fef2f2;
    padding: 10px 14px;
    margin-top: 10px;
    margin-bottom: 14px;
    page-break-inside: avoid;
    -pdf-keep-with-next: true;
  }
  .attack-box-title {
    font-size: 9pt;
    font-weight: bold;
    color: #991b1b;
    margin-bottom: 6px;
  }
  .attack-step {
    font-size: 8.5pt;
    margin: 4px 0 4px 14px;
    color: #7f1d1d;
  }

  /* ── ML Anomaly Row ──────────────────────────────────────── */
  .ml-row {
    margin-top: 10px;
    margin-bottom: 14px;
    padding: 9px 14px;
    font-size: 8.5pt;
    background-color: #f8fafc;
    border-left: 3px solid #64748b;
    page-break-inside: avoid;
  }
  .ml-flagged { border-left-color: #dc2626; background-color: #fef2f2; }
  .ml-normal  { border-left-color: #10b981; background-color: #ecfdf5; }

  /* ── Findings ────────────────────────────────────────────── */
  .findings-title {
    font-size: 8.5pt;
    font-weight: bold;
    color: #0b1f3a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 14px;
    margin-bottom: 8px;
    -pdf-keep-with-next: true;
  }
  .finding-item {
    border-left: 3px solid #cbd5e1;
    padding: 9px 14px;
    margin-bottom: 10px;
    background-color: #f8fafc;
    page-break-inside: avoid;
  }
  .finding-item-CRITICAL { border-left-color: #dc2626; background-color: #fef2f2; }
  .finding-item-HIGH     { border-left-color: #f97316; background-color: #fff7ed; }
  .finding-item-MEDIUM   { border-left-color: #f59e0b; background-color: #fffbeb; }
  .finding-item-LOW      { border-left-color: #10b981; background-color: #ecfdf5; }
  .finding-header {
    font-size: 8.5pt;
    font-weight: bold;
    margin-bottom: 5px;
    -pdf-keep-with-next: true;
  }
  .finding-desc {
    font-size: 8.5pt;
    color: #334155;
    margin-bottom: 7px;
    line-height: 1.5;
  }
  .finding-evidence {
    font-family: Courier, monospace;
    font-size: 8pt;
    color: #1e293b;
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    padding: 4px 10px;
    display: block;
    margin-bottom: 7px;
  }
  .finding-rec {
    font-size: 8pt;
    color: #1d4ed8;
    font-style: italic;
    line-height: 1.4;
  }

  /* ── Recommendations Table ───────────────────────────────── */
  .rec-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    margin-bottom: 22px;
    font-size: 8.5pt;
  }
  .rec-table th {
    background-color: #0b1f3a;
    color: #ffffff;
    padding: 7px 8px;
    text-align: left;
    font-size: 8pt;
    white-space: nowrap;
  }
  .rec-table td {
    border: 1px solid #e2e8f0;
    padding: 7px 8px;
    vertical-align: top;
    font-size: 8.5pt;
  }
  .rec-table tr:nth-child(even) td { background-color: #f8fafc; }

  /* ── Severity colours ────────────────────────────────────── */
  .sev-CRITICAL { color: #991b1b; font-weight: bold; }
  .sev-HIGH     { color: #c2410c; font-weight: bold; }
  .sev-MEDIUM   { color: #b45309; font-weight: bold; }
  .sev-LOW      { color: #047857; font-weight: bold; }

  /* ── Utilities ───────────────────────────────────────────── */
  .mono { font-family: Courier, monospace; font-size: 7.5pt; }
</style>
</head>
<body>

<!-- Running header/footer content (referenced by @frame above) -->
<div id="hdr">SecureMailScope Forensic Report &nbsp;|&nbsp; CONFIDENTIAL</div>
<div id="ftr">Page <pdf:pagenumber/> of <pdf:pagecount/></div>

<!-- ══ TITLE BLOCK ════════════════════════════════════════════ -->
<div class="report-title-block">
  <div class="report-title">SecureMailScope Forensic Report</div>
  <div class="report-subtitle">Automated TLS &amp; Email Security Analysis — CONFIDENTIAL</div>
</div>

<table class="meta-table">
  <tr>
    <td class="meta-label" width="20%">Source File</td>
    <td class="meta-value-source mono" width="30%">
      {%- set raw_path = (data.metadata.filename or 'unknown.pcap') | replace('\\', '/') -%}
      {{ raw_path.split('/')[-1] }}
    </td>
    <td class="meta-label" width="20%">Generated At</td>
    <td class="meta-value" width="30%">{{ data.metadata.analyzed_at[:19] | replace('T', ' ') }} UTC</td>
  </tr>
  <tr>
    <td class="meta-label" width="20%">Total Sessions</td>
    <td class="meta-value" width="30%">{{ data.summary.total_sessions }}</td>
    <td class="meta-label" width="20%">Classification</td>
    <td class="meta-value" width="30%">CONFIDENTIAL — Authorized Personnel Only</td>
  </tr>
</table>

<!-- ══ SECTION 1 — RISK OVERVIEW ══════════════════════════════ -->
<h2>1. Risk Overview</h2>

<table class="overview-table">
  <tr>
    <td>
      <div class="risk-box rb-total">
        <div class="risk-box-label">Total Sessions</div>
        <div class="risk-box-value">{{ data.summary.total_sessions }}</div>
      </div>
    </td>
    <td>
      <div class="risk-box rb-low">
        <div class="risk-box-label">Low Risk</div>
        <div class="risk-box-value">{{ data.summary.low_risk }}</div>
      </div>
    </td>
    <td>
      <div class="risk-box rb-medium">
        <div class="risk-box-label">Medium Risk</div>
        <div class="risk-box-value">{{ data.summary.medium_risk or 0 }}</div>
      </div>
    </td>
    <td>
      <div class="risk-box rb-high">
        <div class="risk-box-label">High / Critical</div>
        <div class="risk-box-value">{{ data.summary.high_risk }}</div>
      </div>
    </td>
  </tr>
</table>

<!-- ══ SECTION 2 — SESSION SUMMARY TABLE ══════════════════════ -->
<h2>2. Session Summary</h2>

<table class="summary-tbl">
  <thead>
    <tr>
      <th width="13%">Session</th>
      <th width="8%">Protocol</th>
      <th width="10%">TLS Ver.</th>
      <th width="27%">Cipher Suite</th>
      <th width="8%">Cert</th>
      <th width="10%">STARTTLS</th>
      <th width="14%">Risk</th>
      <th width="10%">ML</th>
    </tr>
  </thead>
  <tbody>
    {% for s in data.sessions %}
    {% set tls  = s.tls or {} %}
    {% set cert = s.certificate or {} %}
    {% set st   = s.starttls or {} %}
    {% set anom = s.anomaly or {} %}
    <tr>
      <td class="mono">{{ s.session_id }}</td>
      <td>{{ s.protocol or 'N/A' }}</td>
      <td>{{ tls.version or 'Plaintext' }}</td>
      <td class="mono" style="font-size: 7.5pt;">
        {%- if tls.cipher_suite -%}
          {{ tls.cipher_suite
              | replace('TLS_ECDHE_RSA_WITH_', 'ECDHE-RSA-')
              | replace('TLS_ECDHE_ECDSA_WITH_', 'ECDHE-ECDSA-')
              | replace('TLS_RSA_WITH_', 'RSA-')
              | replace('TLS_AES_256_GCM_SHA384', 'AES-256-GCM-SHA384')
              | replace('TLS_AES_128_GCM_SHA256', 'AES-128-GCM-SHA256')
              | replace('TLS_CHACHA20_POLY1305_SHA256', 'CHACHA20-POLY1305')
          }}
        {%- else -%}
          None
        {%- endif -%}
      </td>
      <td>
        {%- if cert.present -%}
          {%- if cert.expired -%}Expired{%- else -%}Valid{%- endif -%}
        {%- else -%}Missing{%- endif -%}
      </td>
      <td>
        {%- if st.attempted and not st.succeeded -%}Stripped
        {%- elif st.succeeded -%}Negotiated
        {%- else -%}Not Used{%- endif -%}
      </td>
      <td>
        <span class="badge badge-{{ s.risk.level }}">{{ s.risk.level }} ({{ s.risk.score }})</span>
      </td>
      <td>
        {%- if anom.flagged == true -%}<span class="sev-CRITICAL">Yes</span>
        {%- elif anom.flagged == false -%}<span class="sev-LOW">No</span>
        {%- else -%}N/A{%- endif -%}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<!-- ══ SECTION 3 — SESSION DETAILS & FINDINGS ══════════════════ -->
<h2>3. Session Details &amp; Security Findings</h2>

{% for s in data.sessions %}
{% set tls  = s.tls or {} %}
{% set cert = s.certificate or {} %}
{% set st   = s.starttls or {} %}
{% set anom = s.anomaly or {} %}

<div class="session-card">
  <div class="session-card-header">
    {{ s.session_id }}&nbsp;&nbsp;|&nbsp;&nbsp;Protocol: {{ s.protocol or 'N/A' }}&nbsp;&nbsp;|&nbsp;&nbsp;TCP Stream: {{ s.stream_id if s.stream_id is not none else 'N/A' }}&nbsp;&nbsp;|&nbsp;&nbsp;Risk:&nbsp;<span class="badge badge-{{ s.risk.level }}">{{ s.risk.level }} ({{ s.risk.score }})</span>
  </div>
  <div class="session-card-body">

    <!-- Two-column TLS / Certificate detail grid -->
    <table width="100%">
      <tr>
        <td class="detail-col-left">
          <div class="detail-section-title">TLS / Encryption</div>
          <table class="detail-grid">
            <tr>
              <td class="detail-label">Encrypted:</td>
              <td class="detail-value">{{ 'Yes' if tls.detected else 'No (Plaintext)' }}</td>
            </tr>
            <tr>
              <td class="detail-label">TLS Version:</td>
              <td class="detail-value">{{ tls.version or 'N/A' }}</td>
            </tr>
            <tr>
              <td class="detail-label">Cipher Suite:</td>
              <td class="detail-value mono" style="font-size: 7.5pt;">{{ tls.cipher_suite or 'N/A' }}</td>
            </tr>
          </table>
        </td>
        <td class="detail-col-right">
          <div class="detail-section-title">Certificate &amp; STARTTLS</div>
          <table class="detail-grid">
            <tr>
              <td class="detail-label">Certificate:</td>
              <td class="detail-value">{{ 'Present' if cert.present else 'Not Present' }}</td>
            </tr>
            {% if cert.present %}
            <tr>
              <td class="detail-label">Status:</td>
              <td class="detail-value">{{ 'EXPIRED' if cert.expired else 'Valid' }}</td>
            </tr>
            {% endif %}
            {% if cert.subject %}
            <tr>
              <td class="detail-label">Subject:</td>
              <td class="detail-value" style="font-size: 8pt;">{{ cert.subject }}</td>
            </tr>
            {% endif %}
            {% if cert.valid_from %}
            <tr>
              <td class="detail-label">Valid From:</td>
              <td class="detail-value" style="font-size: 8pt;">{{ cert.valid_from }}</td>
            </tr>
            {% endif %}
            {% if cert.valid_until %}
            <tr>
              <td class="detail-label">Valid Until:</td>
              <td class="detail-value" style="font-size: 8pt;">{{ cert.valid_until }}</td>
            </tr>
            {% endif %}
            <tr>
              <td class="detail-label">STARTTLS:</td>
              <td class="detail-value">
                {%- if st.attempted and not st.succeeded -%}
                  <span class="sev-CRITICAL">STRIPPED (Attack)</span>
                {%- elif st.succeeded -%}
                  <span class="sev-LOW">Negotiated</span>
                {%- elif st.attempted -%}
                  Attempted
                {%- else -%}Not Used{%- endif -%}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>

    <hr class="divider">

    <!-- STARTTLS Stripping Attack -->
    {% if st.attempted and not st.succeeded %}
    <div class="attack-box">
      <div class="attack-box-title">ATTACK DETECTED — STARTTLS Stripping</div>
      <div class="attack-step">1. Server advertises STARTTLS capability (EHLO 250 response)</div>
      <div class="attack-step">2. Client sends STARTTLS upgrade request</div>
      <div class="attack-step">3. Server / MITM returns 502 error — upgrade blocked</div>
      <div class="attack-step">4. Session falls back to cleartext; credentials &amp; content exposed</div>
    </div>
    {% endif %}

    <!-- ML Anomaly -->
    {% if anom and anom.flagged is not none %}
    <div class="ml-row {% if anom.flagged %}ml-flagged{% else %}ml-normal{% endif %}">
      <b>Behavioral Anomaly (ML / IsolationForest):</b>&nbsp;
      {% if anom.flagged %}
        <span class="sev-CRITICAL">FLAGGED</span> — Score: {{ anom.anomaly_score }}.
        Session deviates significantly from baseline traffic patterns.
      {% else %}
        <span class="sev-LOW">Normal</span> — Score: {{ anom.anomaly_score }}.
        No statistical anomalies detected.
      {% endif %}
    </div>
    {% endif %}

    <!-- Findings -->
    {% if s.findings %}
    <div class="findings-title">Security Findings ({{ s.findings | length }})</div>
    {% for f in s.findings %}
    <div class="finding-item finding-item-{{ f.severity }}">
      <div class="finding-header">
        <span class="sev-{{ f.severity }}">[{{ f.severity }}]</span>&nbsp;{{ f.title }}
      </div>
      <div class="finding-desc">{{ f.description }}</div>
      <span class="finding-evidence">Evidence: {{ f.evidence }}</span>
      <div class="finding-rec">Recommendation: {{ f.recommendation }}</div>
    </div>
    {% endfor %}
    {% else %}
    <div class="finding-item finding-item-LOW">
      <div class="finding-desc">No security findings recorded for this session.</div>
    </div>
    {% endif %}

  </div><!-- /session-card-body -->
</div><!-- /session-card -->
{% endfor %}

<!-- ══ SECTION 4 — RECOMMENDATIONS ══════════════════════════════ -->
<h2>4. Recommendations</h2>

{% set ns = namespace(has_recs=false) %}
{% for s in data.sessions %}
{% for f in s.findings %}
{% if f.severity in ['CRITICAL', 'HIGH', 'MEDIUM'] %}
{% set ns.has_recs = true %}
{% endif %}
{% endfor %}
{% endfor %}

{% if ns.has_recs %}
<table class="rec-table">
  <thead>
    <tr>
      <th width="12%">Session</th>
      <th width="12%">Severity</th>
      <th width="28%">Finding</th>
      <th width="48%">Recommended Action</th>
    </tr>
  </thead>
  <tbody>
    {% for s in data.sessions %}
    {% for f in s.findings %}
    {% if f.severity in ['CRITICAL', 'HIGH', 'MEDIUM'] %}
    <tr>
      <td class="mono">{{ s.session_id }}</td>
      <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
      <td>{{ f.title }}</td>
      <td>{{ f.recommendation }}</td>
    </tr>
    {% endif %}
    {% endfor %}
    {% endfor %}
  </tbody>
</table>
{% else %}
<div class="finding-item finding-item-LOW">
  <div class="finding-desc">All sessions passed security review. No remediation actions required.</div>
</div>
{% endif %}

</body>
</html>
