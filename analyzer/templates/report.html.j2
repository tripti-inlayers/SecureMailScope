<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Helvetica, Arial, sans-serif; margin: 30px; color: #1A202C; }
  h1 { color: #0B1F3A; }
  .summary { display: flex; gap: 20px; margin-bottom: 20px; }
  .card { border: 1px solid #E2E8F0; border-radius: 6px; padding: 10px 16px; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  th, td { border: 1px solid #E2E8F0; padding: 6px 10px; text-align: left; font-size: 12px; }
  th { background: #0B1F3A; color: white; }
  .LOW { background: #E9F9EF; }
  .MEDIUM { background: #FFF7E6; }
  .HIGH, .CRITICAL { background: #FDEBEC; }
</style>
</head>
<body>
  <h1>SecureMailScope Forensic Report</h1>
  <p>File: {{ data.metadata.filename }} &nbsp;|&nbsp; Analyzed: {{ data.metadata.analyzed_at }}</p>
  <div class="summary">
    <div class="card">Total Sessions: {{ data.summary.total_sessions }}</div>
    <div class="card">Low: {{ data.summary.low_risk }}</div>
    <div class="card">Medium: {{ data.summary.medium_risk }}</div>
    <div class="card">High: {{ data.summary.high_risk }}</div>
  </div>
  <table>
    <tr><th>Session</th><th>Protocol</th><th>TLS Version</th><th>Cert Valid</th><th>Risk</th></tr>
    {% for s in data.sessions %}
    <tr class="{{ s.risk.level }}">
      <td>{{ s.session_id }}</td>
      <td>{{ s.protocol }}</td>
      <td>{{ s.tls.version or 'N/A' }}</td>
      <td>{{ 'No' if s.certificate.expired else 'Yes' if s.certificate.present else 'N/A' }}</td>
      <td>{{ s.risk.level }} ({{ s.risk.score }})</td>
    </tr>
    {% endfor %}
  </table>
  <h2>Findings Detail</h2>
  {% for s in data.sessions %}
    <h3>{{ s.session_id }} — {{ s.risk.level }}</h3>
    {% for f in s.findings %}
      <p><b>{{ f.title }}</b> [{{ f.severity }}]<br>
      {{ f.description }}<br>
      <i>Evidence: {{ f.evidence }}</i><br>
      Recommendation: {{ f.recommendation }}</p>
    {% endfor %}
  {% endfor %}
</body>
</html>
